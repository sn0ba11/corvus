OSINT_BIND_HOST=127.0.0.1
OSINT_PORT=8000
OSINT_DATABASE_URL=sqlite:////data/osint.db
OSINT_DATA_DIR=/data
OSINT_SECRET_KEY=
OSINT_SEARXNG_SECRET=
OSINT_MAX_CONCURRENT_INVESTIGATIONS=2
OSINT_MAX_CONCURRENT_COLLECTORS=3
OSINT_LOG_QUERIES=false
OSINT_LOCAL_AUTH_ENABLED=false
OSINT_LOCAL_AUTH_USERNAME=investigator
OSINT_LOCAL_AUTH_PASSWORD_HASH=
OSINT_SECURE_COOKIES=false
OSINT_HTTP_PROXY=
OSINT_HTTPS_PROXY=
OSINT_SOCKS_PROXY=
OSINT_TOR_PROXY=
OSINT_STEAM_WEB_API_KEY=
OSINT_URLSCAN_API_KEY=
OSINT_COMPANIES_HOUSE_API_KEY=
OSINT_ABUSEIPDB_API_KEY=
OSINT_OPENPHISH_FEED_URL=
OSINT_INSTALOADER_SESSION_USERNAME=
OSINT_BROWSER_ENABLED=true
OSINT_BROWSER_AGENT_URL=http://browser-agent:8080
OSINT_BROWSER_AGENT_TOKEN=
OSINT_BROWSER_SHARE_SESSIONS=false
OSINT_BROWSER_DESKTOP_PORT=6080
OSINT_BROWSER_DESKTOP_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
OSINT_BROWSER_ALLOWED_HOSTS=google.com,google.ie,bing.com,mojeek.com,duckduckgo.com,brave.com,qwant.com,startpage.com,tripadvisor.com,tripadvisor.ie,tripadvisor.co.uk,strava.com,alltrails.com,komoot.com,garmin.com,instagram.com,facebook.com,facebook.net,fb.com,fbcdn.net,fbsbx.com,messenger.com,meta.com,linkedin.com,x.com,twitter.com,tiktok.com,snapchat.com,t.me,telegram.org,discord.com,discord.gg,whatsapp.com,wa.me,reddit.com,github.com,gitlab.com
OSINT_BROWSER_MAIGRET_SESSION_HOSTS=instagram.com,facebook.com,linkedin.com,x.com,twitter.com,tiktok.com,reddit.com,github.com,gitlab.com
OSINT_BROWSER_REQUEST_TIMEOUT_SECONDS=45
OSINT_BROWSER_MAX_HTML_BYTES=1048576
OSINT_BROWSER_NAVIGATION_TIMEOUT_MS=30000
OSINT_BROWSER_LOCALE=en-IE
# Reduces how often Google/Bing flag the managed browser as automated (fewer manual-resume
# pauses on searches); does not bypass a challenge once one is shown. Off by default. Requires
# restarting the browser-agent container to take effect (patched browser driver is selected at
# process startup, not per-request). See THIRD_PARTY_NOTICES.md.
OSINT_STEALTH_BROWSER_ENABLED=false
